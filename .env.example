# Скопируйте в .env. НЕ коммитьте .env.
# Укажите только те провайдеры/каналы, которыми будете пользоваться.

# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# TELEGRAM_BOT_TOKEN=

# Доступ к SpaceWeb/production НЕ хранить здесь до настройки отдельного
# ограниченного пользователя и ключа. Предпочтительно read-only SSH на первом этапе.
# TERMINAL_SSH_HOST=
# TERMINAL_SSH_USER=
# TERMINAL_SSH_KEY=
